    <!-- about -->
    <string name="about_title">About</string>
    <string name="about_body">Mihakk keeps a reviewer\'s working record on the reviewer\'s own device. Manuscript titles, author names and draft reports are confidential material entrusted to you by a journal — none of it is uploaded anywhere. The only network call the app can make is the optional ORCID import, and ORCID records carry no manuscript identity.</string>
    <string name="about_credits">Built by Dr. Mohammed Tawfik</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_content_note">Checklists are original reviewer-facing questions written for this app, informed by the public reporting guidelines named on each one. They are an aid to judgement, not a substitute for it.</string>

