<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Reviewer material is confidential; keep it out of cloud backup and
         device-to-device transfer. Use the app's own export instead. -->
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
